# Frontend env (Vite). Nothing secret belongs here: everything is shipped to the browser.
# Where the dev server proxies /api (default http://localhost:8000)
VITE_API_PROXY=http://localhost:8000
# Show the demo inbox link on the forgot-password page
VITE_DEMO_MODE=true
# Production only: the API host for live WebSocket updates (Vercel cannot proxy sockets),
# e.g. wss://your-api.onrender.com. Leave empty locally: Vite proxies /ws.
VITE_WS_URL=
