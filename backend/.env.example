# Copy to backend/.env for local development. NEVER commit the real .env.
# Generate keys with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

DEBUG=true
SECRET_KEY=
DATABASE_URL=postgres://talentpath:talentpath@127.0.0.1:55432/talentpath
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
INTERNAL_TICK_SECRET=

ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
DEMO_MODE=true
# Optional
REDIS_URL=
NUM_PROXIES=0
DEMO_PASSWORD=
# Local only: Playwright signs in ~14 times a minute. Production default is 10/min.
THROTTLE_LOGIN=120/min
# Optional: Ask HIRA questions per minute per visitor (default 30/min)
THROTTLE_HIRA=
# Optional: scheduling-link requests per minute per visitor (default 30/min)
THROTTLE_SCHEDULE_LINK=

# --- Email (docs/EMAIL.md) ------------------------------------------------------
# console = nothing is sent, one log line per email (default). smtp = Gmail with an App
# Password (local use). api = Brevo or Resend over HTTPS (Render's free plan blocks SMTP).
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=TalentPath
# smtp (Gmail): your Gmail address and a 16-character App Password. Never your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# api: brevo or resend, and its API key.
EMAIL_API_PROVIDER=
EMAIL_API_KEY=
# When set, real emails go only to these addresses or @domains; others stay in the outbox.
EMAIL_ALLOWLIST=
# Optional limits (defaults: 10 per recipient per hour, 60 per hour, 250 per day).
EMAIL_MAX_PER_RECIPIENT_PER_HOUR=
EMAIL_MAX_PER_HOUR=
EMAIL_DAILY_CAP=
